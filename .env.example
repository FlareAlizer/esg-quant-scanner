# Скопируй в .env и подставь свои значения. .env в git не попадает.

# --- LLM (любой OpenAI-совместимый эндпоинт) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.vsegpt.ru/v1
LLM_MODEL_NAME=deepseek/deepseek-r1-alt
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3

# --- Параметры модели ---
RISK_FREE_RATE=0.04
RANDOM_SEED=42
